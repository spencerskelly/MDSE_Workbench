{
  "name": "mdse-workbench",
  "version": "0.1.18",
  "description": "Everyday engineer interface to the MDSE model vault (Create / Explore / Review). Phase 0 spike.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench:generate": "tsx bench/generate-vault.ts",
    "bench": "tsx bench/run-bench.ts",
    "bench:cache": "tsx bench/cache-bench.ts",
    "bench:startup": "tsx bench/startup-bench.ts",
    "bench:relationships": "tsx bench/relationship-reresolution-bench.ts",
    "accept:real-vault": "tsx scripts/real-vault-acceptance.ts",
    "accept:real-vault:scan": "tsx scripts/real-vault-readonly-scan.ts",
    "accept:real-vault:views": "tsx scripts/real-vault-view-check.ts",
    "accept:real-vault:edits": "tsx scripts/real-vault-edit-check.ts",
    "accept:real-vault:05": "tsx scripts/real-vault-05-acceptance.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0"
  }
}
